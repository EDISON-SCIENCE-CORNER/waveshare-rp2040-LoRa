/*
  ============================================================================
   LoRa RANGE TEST  -  RECEIVER  (OLED + status LEDs)
  ============================================================================
   Board  : Waveshare RP2040-LoRa-HF  (Tools > Board > "Waveshare RP2040 LoRa")
   Library: RadioLib + U8g2
   Display: 1.3" I2C OLED (SH1106)  SDA -> GP4, SCL -> GP5, VCC -> 3V3, GND -> GND

   Status LEDs (each through a 220-330 ohm resistor to GND):
     GP6 -> "LINK OK"   LED : slow breathing fade while packets are arriving
     GP7 -> "LINK FAIL" LED : solid ON when communication is lost
   The LEDs run on the RP2040's second core so the fade stays smooth.

   Screen:
     +--------------------------------+
     | LINK GOOD                signal |   status + 5 signal bars
     +---------------+----------------+
     | RSSI (dBm)    | SNR (dB)       |
     |     -87       |     9.5        |
     +---------------+----------------+
     | RANGE [=======   ]  72%        |   10-segment link-quality bar
     | RX 1234 LOST 12 PSR99%         |   packet statistics
     +--------------------------------+
   PSR = packet success rate over the last 32 pings.
   Every packet is also logged on USB Serial as CSV.
  ============================================================================
*/

#include <Wire.h>
#include <SPI.h>
#include <RadioLib.h>
#include <U8g2lib.h>

// ============================ USER SETTINGS =================================
#define PING_INTERVAL_MS  1000UL     // must match the transmitter
#define LINK_TIMEOUT_MS   3500UL     // no packet for this long = LINK FAILED

// ---- LoRa settings: MUST be identical on transmitter and receiver ----
#define LORA_FREQ_MHZ     866.0
#define LORA_BW_KHZ       125.0
#define LORA_SF           9
#define LORA_CR           7
#define LORA_SYNC_WORD    0x12
#define LORA_TX_DBM       17         // not used for receiving, begin() needs it
#define LORA_PREAMBLE     8

// ---- Pins ----
#define I2C_SDA           4
#define I2C_SCL           5
#define LED_OK_PIN        6          // fades while link is OK
#define LED_FAIL_PIN      7          // ON when link has failed

#define FADE_PERIOD_MS    2000       // one full breath of the OK LED
// ============================================================================

U8G2_SH1106_128X64_NONAME_F_HW_I2C oled(U8G2_R0, U8X8_PIN_NONE);
// U8G2_SSD1306_128X64_NONAME_F_HW_I2C oled(U8G2_R0, U8X8_PIN_NONE);

// ---- RP2040-LoRa on-board radio wiring (fixed) ----
#define LORA_SCK   14
#define LORA_MOSI  15
#define LORA_MISO  24
#define LORA_CS    13
#define LORA_RST   23
#define LORA_BUSY  18
#define LORA_DIO1  16
#define LORA_RXEN  17

#ifndef LED_BUILTIN
#define LED_BUILTIN 25
#endif

SX1262 radio = new Module(LORA_CS, LORA_DIO1, LORA_RST, LORA_BUSY, SPI1);

// ---- Packet (must match transmitter) ----
struct __attribute__((packed)) PingPacket {
  uint8_t  magic[2];   // 'R','T'
  uint32_t counter;
  int8_t   txPower;
  uint8_t  sf;
};

// ---- State ----
volatile bool packetFlag = false;
volatile bool linkOk     = false;    // read by core 1 (LEDs)

bool     haveData    = false;
uint32_t lastRxMs    = 0;
uint32_t lastCounter = 0;
float    lastRssi    = 0;
float    lastSnr     = 0;
uint8_t  quality     = 0;            // 0..100 %
uint32_t rxCount     = 0;
uint32_t lostCount   = 0;
uint32_t history     = 0;            // 1 bit per expected ping, newest = bit 0
uint8_t  historyLen  = 0;            // valid bits in history (max 32)
uint32_t ledOffAt    = 0;

void onPacket() { packetFlag = true; }

// ============================================================================
//  Link quality
// ============================================================================
// Combine RSSI and SNR into one 0-100 % figure. The weaker of the two wins:
//   RSSI  -125 dBm (edge for SF9)  ..  -60 dBm (very close)
//   SNR    -15 dB  (edge for SF9)  ..  +10 dB  (clean signal)
uint8_t calcQuality(float rssi, float snr) {
  float r = (rssi + 125.0f) / 65.0f * 100.0f;
  float s = (snr  + 15.0f)  / 25.0f * 100.0f;
  float q = min(r, s);
  if (q < 0)   q = 0;
  if (q > 100) q = 100;
  return (uint8_t)(q + 0.5f);
}

const char *qualityText(uint8_t q) {
  if (q >= 80) return "EXCELLENT";
  if (q >= 60) return "GOOD";
  if (q >= 40) return "FAIR";
  if (q >= 20) return "WEAK";
  return "VERY WEAK";
}

void pushHistory(bool received) {
  history = (history << 1) | (received ? 1 : 0);
  if (historyLen < 32) historyLen++;
}

uint8_t successRate() {
  if (historyLen == 0) return 0;
  uint32_t mask = (historyLen >= 32) ? 0xFFFFFFFFUL : ((1UL << historyLen) - 1);
  return (uint8_t)(__builtin_popcount(history & mask) * 100 / historyLen);
}

void resetStats() {
  rxCount = lostCount = 0;
  history = 0;
  historyLen = 0;
}

// ============================================================================
//  Display
// ============================================================================
void drawCentered(int x, int w, int baseline, const char *text) {
  oled.drawStr(x + (w - (int)oled.getStrWidth(text)) / 2, baseline, text);
}

void drawBox(int x, int y, int w, int h, const char *title, const char *value) {
  oled.drawFrame(x, y, w, h);
  oled.setFont(u8g2_font_4x6_tf);
  oled.drawStr(x + 3, y + 7, title);
  oled.setFont(u8g2_font_8x13B_tf);
  drawCentered(x, w, y + h - 5, value);
}

// Phone-style signal bars, bottom-left at (x, yBottom)
void drawSignalBars(int x, int yBottom, uint8_t bars) {
  for (uint8_t i = 0; i < 5; i++) {
    int h  = 3 + i * 2;
    int bx = x + i * 5;
    if (i < bars) oled.drawBox(bx, yBottom - h + 1, 4, h);
    else          oled.drawFrame(bx, yBottom - h + 1, 4, h);
  }
}

void updateDisplay() {
  char buf[32];
  uint32_t age = millis() - lastRxMs;
  uint8_t bars = linkOk ? (quality + 19) / 20 : 0;     // 0..5

  oled.clearBuffer();

  // ---- Header: link status + signal bars ----
  oled.setFont(u8g2_font_6x10_tf);
  if (linkOk) {
    snprintf(buf, sizeof(buf), "LINK %s", qualityText(quality));
    oled.drawStr(0, 9, buf);
  } else {
    if (haveData) snprintf(buf, sizeof(buf), "NO LINK %lus", (unsigned long)(age / 1000));
    else          snprintf(buf, sizeof(buf), "SEARCHING...");
    oled.drawBox(0, 0, 98, 11);
    oled.setDrawColor(0);
    oled.drawStr(2, 9, buf);
    oled.setDrawColor(1);
  }
  drawSignalBars(103, 10, bars);

  // ---- RSSI / SNR boxes (last received values) ----
  char rssiStr[10] = "--", snrStr[10] = "--";
  if (haveData) {
    snprintf(rssiStr, sizeof(rssiStr), "%d", (int)lastRssi);
    snprintf(snrStr,  sizeof(snrStr),  "%.1f", lastSnr);
  }
  drawBox(0,  13, 64, 27, "RSSI (dBm)", rssiStr);
  drawBox(63, 13, 65, 27, "SNR (dB)",   snrStr);

  // ---- Range / quality bar (10 segments) ----
  oled.setFont(u8g2_font_4x6_tf);
  oled.drawStr(0, 51, "RANGE");
  const int bx = 22, by = 43, bw = 83, bh = 10;
  oled.drawFrame(bx, by, bw, bh);
  uint8_t q = linkOk ? quality : 0;
  uint8_t segs = (q + 5) / 10;                        // 0..10 segments
  for (uint8_t i = 0; i < segs; i++) {
    oled.drawBox(bx + 2 + i * 8, by + 2, 7, bh - 4);
  }
  oled.setFont(u8g2_font_5x7_tf);
  snprintf(buf, sizeof(buf), "%u%%", q);
  oled.drawStr(128 - oled.getStrWidth(buf), by + 8, buf);

  // ---- Packet statistics ----
  oled.setFont(u8g2_font_5x7_tf);
  snprintf(buf, sizeof(buf), "RX %lu LOST %lu PSR%u%%",
           (unsigned long)rxCount, (unsigned long)lostCount, successRate());
  oled.drawStr(0, 63, buf);

  oled.sendBuffer();
}

// ============================================================================
//  Radio
// ============================================================================
bool radioBegin() {
  SPI1.setRX(LORA_MISO);
  SPI1.setSCK(LORA_SCK);
  SPI1.setTX(LORA_MOSI);
  SPI1.begin();

  int state = radio.begin(LORA_FREQ_MHZ, LORA_BW_KHZ, LORA_SF, LORA_CR,
                          LORA_SYNC_WORD, LORA_TX_DBM, LORA_PREAMBLE, 0.0, false);
  if (state != RADIOLIB_ERR_NONE) {
    state = radio.begin(LORA_FREQ_MHZ, LORA_BW_KHZ, LORA_SF, LORA_CR,
                        LORA_SYNC_WORD, LORA_TX_DBM, LORA_PREAMBLE, 1.8, false);
  }
  if (state != RADIOLIB_ERR_NONE) {
    Serial.printf("[LoRa] init FAILED, code %d\n", state);
    return false;
  }
  radio.setDio2AsRfSwitch(true);
  radio.setRfSwitchPins(LORA_RXEN, RADIOLIB_NC);
  radio.setPacketReceivedAction(onPacket);
  return radio.startReceive() == RADIOLIB_ERR_NONE;
}

void handlePacket() {
  uint8_t buf[32];
  size_t len = radio.getPacketLength();
  if (len > sizeof(buf)) len = sizeof(buf);
  int state = radio.readData(buf, len);

  if (state == RADIOLIB_ERR_CRC_MISMATCH) {
    Serial.println(F("# CRC error (packet corrupted - near edge of range)"));
  } else if (state == RADIOLIB_ERR_NONE && len == sizeof(PingPacket) && buf[0] == 'R' && buf[1] == 'T') {
    PingPacket p;
    memcpy(&p, buf, sizeof(p));

    if (haveData) {
      uint32_t gap = p.counter - lastCounter;
      if (p.counter <= lastCounter || gap > 10000) {
        resetStats();                                // transmitter was restarted
        Serial.println(F("# transmitter restarted - stats reset"));
      } else {
        for (uint32_t i = 1; i < gap; i++) pushHistory(false);
        lostCount += gap - 1;
      }
    }
    pushHistory(true);
    rxCount++;

    lastCounter = p.counter;
    lastRssi    = radio.getRSSI();
    lastSnr     = radio.getSNR();
    quality     = calcQuality(lastRssi, lastSnr);
    lastRxMs    = millis();
    haveData    = true;
    linkOk      = true;

    digitalWrite(LED_BUILTIN, HIGH);
    ledOffAt = millis() + 50;

    // CSV: time_ms,counter,rssi,snr,quality,rx,lost,psr
    Serial.printf("%lu,%lu,%.0f,%.1f,%u,%lu,%lu,%u\n",
                  (unsigned long)lastRxMs, (unsigned long)p.counter, lastRssi, lastSnr,
                  quality, (unsigned long)rxCount, (unsigned long)lostCount, successRate());
    updateDisplay();
  }

  radio.startReceive();
}

// ============================================================================
//  Core 0: radio + display
// ============================================================================
void setup() {
  pinMode(LED_BUILTIN, OUTPUT);
  Serial.begin(115200);
  uint32_t t0 = millis();
  while (!Serial && millis() - t0 < 2000) { }
  Serial.println(F("\n=== LoRa RANGE TEST - RECEIVER ==="));

  Wire.setSDA(I2C_SDA);
  Wire.setSCL(I2C_SCL);
  oled.setBusClock(400000);
  oled.begin();

  if (!radioBegin()) {
    oled.clearBuffer();
    oled.setFont(u8g2_font_7x13B_tf);
    oled.drawStr(0, 30, "LoRa init FAILED");
    oled.sendBuffer();
    while (true) { delay(1000); }
  }

  Serial.printf("Listening on %.1f MHz SF%d BW%.0f\n", LORA_FREQ_MHZ, LORA_SF, LORA_BW_KHZ);
  Serial.println(F("time_ms,counter,rssi_dbm,snr_db,quality_pct,rx,lost,psr_pct"));
  updateDisplay();
}

void loop() {
  if (packetFlag) {
    packetFlag = false;
    handlePacket();
  }

  // Link timeout
  if (linkOk && millis() - lastRxMs > LINK_TIMEOUT_MS) {
    linkOk = false;
    Serial.println(F("# LINK LOST"));
  }

  if (ledOffAt && (int32_t)(millis() - ledOffAt) >= 0) {
    digitalWrite(LED_BUILTIN, LOW);
    ledOffAt = 0;
  }

  static uint32_t lastDraw = 0;
  if (millis() - lastDraw >= 250) {
    lastDraw = millis();
    updateDisplay();
  }
}

// ============================================================================
//  Core 1: status LEDs (runs in parallel, so the fade is always smooth)
// ============================================================================
void setup1() {
  pinMode(LED_OK_PIN, OUTPUT);
  pinMode(LED_FAIL_PIN, OUTPUT);
  analogWriteRange(1023);
  analogWriteFreq(1000);
}

void loop1() {
  if (linkOk) {
    // Breathing: 0 -> full -> 0, squared for a natural-looking fade
    float phase = (millis() % FADE_PERIOD_MS) / (float)FADE_PERIOD_MS;   // 0..1
    float tri   = phase < 0.5f ? phase * 2.0f : (1.0f - phase) * 2.0f;   // 0..1..0
    analogWrite(LED_OK_PIN, (int)(tri * tri * 1023.0f));
    digitalWrite(LED_FAIL_PIN, LOW);
  } else {
    analogWrite(LED_OK_PIN, 0);
    digitalWrite(LED_FAIL_PIN, HIGH);
  }
  delay(10);
}
